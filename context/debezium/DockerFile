FROM debezium/connect:2.4
USER root
RUN microdnf -y install unzip \
    && curl -O https://github.com/ClickHouse/clickhouse-kafka-connect/releases/download/v1.0.113/clickhouse-kafka-connect-v1.0.113.zip \
    && unzip clickhouse-kafka-connect-v1.0.113.zip -d /kafka/connect/clickhouse-sink \
    && rm clickhouse-kafka-connect-v1.0.113.zip
USER kafka